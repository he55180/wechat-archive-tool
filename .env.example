# 微信公众号一键归档系统 - 环境配置文件模板
# 请复制此文件并重命名为 .env，然后填写您自己的配置。

# Gemini API Keys (用于 AI 辅助写作/摘要，多个 API Key 用逗号分隔，系统会自动轮换使用)
# 申请地址: https://aistudio.google.com/apikey
GEMINI_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2

# 兼容旧配置 (单个 Key)
GEMINI_API_KEY=your_gemini_api_key

# Groq API Key (备用模型，申请地址: https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key

# 自动化情报系统 (daily_brief.py) 邮箱发送配置
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_email_authorized_code_or_password
MAIL_TO=recipient_email@example.com
